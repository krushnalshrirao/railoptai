        "department": { "type": "string", "description": "Department" },
        "headquarters": { "type": "string", "description": "Station / Division HQ" },
        "staffId": { "type": "string", "description": "Railway Staff ID" },
        "contactNumber": { "type": "string", "description": "Phone number" },
